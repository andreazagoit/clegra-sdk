          "type": "date"
        },
        "startDate": {
          "type": "date"
        },
        "completed": {
          "type": "boolean"
        },
        "assignee": {
          "type": "string"
        }
      },
      "required": []
    },
    "document": {
      "label": {
        "en": "Document",
        "it": "Documento"
      },
      "properties": {
        "url": {
          "type": "string"
        },
        "encodingFormat": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "contentSize": {
          "type": "string"
        }
      },
      "required": []
    },
    "product": {
      "label": {
        "en": "Product",
        "it": "Prodotto"
      },
      "properties": {
        "sku": {
          "type": "string"
        },
        "gtin": {
          "type": "string",
          "key": true,
          "normalise": "digits"
        },
        "brand": {
          "type": "string"
        },
        "price": {
          "type": "money"
        }
      },
      "required": []
    },
    "order": {
      "label": {
        "en": "Order",
