          "type": "string"
        },
        "familyName": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "many": true,
          "key": true,
          "normalise": "lowercase"
        },
        "telephone": {
          "type": "string",
          "many": true
        },
        "jobTitle": {
          "type": "string"
        },
        "worksFor": {
          "type": "string"
        },
        "address": {
          "type": "address"
        },
        "image": {
          "type": "string"
        }
      },
      "required": []
    },
    "organization": {
      "label": {
        "en": "Organization",
        "it": "Organizzazione"
      },
      "properties": {
        "legalName": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "many": true
        },
        "telephone": {
          "type": "string",
          "many": true
        },
        "url": {
          "type": "string"
        },
        "address": {
          "type": "address"
        },
        "vatID": {
          "type": "string",
          "key": true,
          "normalise": "uppercase-no-spaces"
        },
        "taxID": {
          "type": "string"
        }
      },
      "required": []
    },
    "event": {
      "label": {
        "en": "Event",
        "it": "Evento"
      },
