        },
        "organizer": {
          "type": "string"
        },
        "uid": {
          "type": "string",
          "key": true,
          "normalise": "exact"
        }
      },
      "required": [
        "startDate"
      ]
    },
    "task": {
      "label": {
        "en": "Task",
        "it": "Attività"
