  "universal": {
    "url": {
      "type": "string"
    },
    "dateCreated": {
      "type": "date"
    },
    "dateModified": {
      "type": "date"
    }
  },
  "reserved": [
    "message",
    "place",
    "invoice",
    "project"
  ]
