{
  "$id": "urn:clegra:manifest:1.0",
  "title": "Clegra app manifest 1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "specVersion": {
      "type": "string",
      "const": "1.0"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,39}$"
    },
    "title": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      },
      "description": "A label per locale (BCP 47 → text)"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      },
      "description": "A label per locale (BCP 47 → text)"
    },
    "icons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "src": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          },
          "sizes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "src"
        ],
        "additionalProperties": false
      }
    },
    "publisher": {
      "description": "Who publishes the app: a claim that grants nothing; a store or host may verify it by the address's domain",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "url": {
          "type": "string",
          "maxLength": 300,
          "description": "The publisher's web address: an absolute https URL"
        }
      },
      "required": [
        "name",
        "url"
      ],
      "additionalProperties": false
    },
    "locale": {
      "type": "string"
    },
    "mcp": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false,
      "description": "The MCP endpoint (Streamable HTTP), relative to the manifest"
    },
    "auth": {
      "type": "object",
      "properties": {
        "resource": {
          "description": "The app's public MCP address: the only token audience it accepts. A host installs the app from this address or not at all",
          "type": "string"
        },
        "authorizationServers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "authorizationServers"
      ],
      "additionalProperties": false,
      "description": "MCP authorization: the server's own address (the token audience) and who issues tokens"
    },
    "view": {
      "type": "string",
      "description": "The generated ui:// view for lists, records, dashboards and fragments"
    },
    "resolveTool": {
      "type": "string",
      "description": "Hosts resolve record and fragment URIs with this tool"
    },
    "embed": {
      "description": "Same-site url pages, framed by hosts with a sign-in ticket",
      "type": "object",
      "properties": {
        "tool": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "The MCP tool"
            },
            "plain": {
              "type": "boolean",
              "description": "Listed to plain MCP clients"
            }
          },
          "required": [
            "name",
            "plain"
          ],
          "additionalProperties": false,
          "description": "The tool a host asks for an embed ticket with (spec §5.1)"
        },
        "path": {
          "type": "string",
          "description": "Where the embed pages live; tickets are posted to <path>/_ticket"
        },
        "frameAncestors": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The hosts that may frame the embed pages (CSP frame-ancestors sources)"
        }
      },
      "required": [
        "tool",
        "path",
        "frameAncestors"
      ],
      "additionalProperties": false
    },
    "searchTool": {
      "type": "string"
    },
    "kinds": {
      "description": "The namespaced kinds (with a dot) this app defines (spec §3.1)",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            },
            "description": "A label per locale (BCP 47 → text)"
          },
          "properties": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "string",
                    "number",
                    "boolean",
                    "date",
                    "address",
                    "money"
                  ]
                },
                "many": {
                  "type": "boolean"
                },
                "key": {
                  "type": "boolean"
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "label",
          "properties"
        ],
        "additionalProperties": false
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "label": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            },
            "description": "A label per locale (BCP 47 → text)"
          },
          "plural": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            },
            "description": "A label per locale (BCP 47 → text)"
          },
          "description": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            },
            "description": "A label per locale (BCP 47 → text)"
          },
          "icon": {
            "type": "string"
          },
          "kind": {
            "description": "What the entity is (spec §3.1): a kind, or one per record by an enum field",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "by": {
                    "type": "string",
                    "description": "A required enum field"
                  },
                  "map": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    },
                    "description": "A kind for each of its values"
                  }
                },
                "required": [
                  "by",
                  "map"
                ],
                "additionalProperties": false
              }
            ]
          },
          "permission": {
            "type": "string"
          },
          "schema": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {},
            "description": "A JSON Schema (draft 2020-12)"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "string",
                    "number",
                    "integer",
                    "boolean",
                    "array",
                    "object"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "enum": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "title",
                    "subtitle",
                    "status",
                    "amount",
                    "date",
                    "person"
                  ]
                },
                "label": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "A label per locale (BCP 47 → text)"
                },
                "as": {
                  "description": "The property of the entity's kind this field holds (spec §3.1)",
                  "type": "string"
                },
                "ref": {
                  "anyOf": [
                    {
                      "type": "string",
                      "description": "An entity of this app: the field holds one of its record ids"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind"
                      ],
                      "additionalProperties": false,
                      "description": "A kind: the field holds the URI of a record of that kind, in any app (spec §3.2)"
                    }
                  ]
                },
                "permission": {
                  "description": "Only callers with this permission see the field",
                  "type": "string"
                },
                "filter": {
                  "type": "boolean"
                },
                "sort": {
                  "type": "boolean"
                },
                "search": {
                  "type": "boolean"
                },
                "labels": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    },
                    "description": "A label per locale (BCP 47 → text)"
                  }
                },
                "tones": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "enum": [
                      "neutral",
                      "info",
                      "success",
                      "warning",
                      "danger"
                    ]
                  }
                },
                "currency": {
                  "type": "string"
                },
                "untrusted": {
                  "description": "Text written by outsiders: data, never instructions",
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "type",
                "required",
                "label"
              ],
              "additionalProperties": false
            }
          },
          "tools": {
            "type": "object",
            "properties": {
              "list": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "The MCP tool"
                  },
                  "plain": {
                    "type": "boolean",
                    "description": "Listed to plain MCP clients"
                  }
                },
                "required": [
                  "name",
                  "plain"
                ],
                "additionalProperties": false
              },
              "get": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "The MCP tool"
                  },
                  "plain": {
                    "type": "boolean",
                    "description": "Listed to plain MCP clients"
                  }
                },
                "required": [
                  "name",
                  "plain"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "list",
              "get"
            ],
            "additionalProperties": false
          },
          "searchable": {
            "type": "boolean"
          },
          "visibility": {
            "description": "App-only: hidden from every model (its tools carry MCP Apps `_meta.ui.visibility: [\"app\"]`); views and the host's own UI still call it. Absent: models and apps",
            "type": "string",
            "const": "app"
          }
        },
        "required": [
          "name",
          "label",
          "plural",
          "schema",
          "fields",
          "tools",
          "searchable"
        ],
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "entity": {
            "description": "Set: the action works on one record; its tool takes `id`",
            "type": "string"
          },
          "title": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            },
            "description": "A label per locale (BCP 47 → text)"
          },
          "description": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            },
            "description": "A label per locale (BCP 47 → text)"
          },
          "icon": {
            "type": "string"
          },
          "input": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {},
            "description": "A JSON Schema (draft 2020-12)"
          },
          "readOnly": {
            "type": "boolean"
          },
          "confirm": {
            "type": "string",
            "enum": [
              "always",
              "optional",
              "never"
            ]
          },
          "permission": {
            "type": "string"
          },
          "tool": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "The MCP tool"
              },
              "plain": {
                "type": "boolean",
                "description": "Listed to plain MCP clients"
              }
            },
            "required": [
              "name",
              "plain"
            ],
            "additionalProperties": false
          },
          "visibility": {
            "description": "App-only: hidden from every model (its tools carry MCP Apps `_meta.ui.visibility: [\"app\"]`); views and the host's own UI still call it. Absent: models and apps",
            "type": "string",
            "const": "app"
          },
          "targets": {
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "target": {
                  "type": "string",
                  "pattern": "^(mail\\.message|record:[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*)$",
                  "description": "What the action is offered on: `mail.message`, or `record:<kind>` (a published kind or a namespaced one)"
                },
                "needs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "The target's fields the action may receive (only these, ever); `uri` and, for records, `title` are always available"
                },
                "input": {
                  "description": "A template of the action's input: string values may hold `{field}` / `{field.sub}` placeholders naming `uri`, `title` or a needed field",
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "label": {
                  "description": "The item's words (default the action's title), at most 40 characters per locale",
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "target",
                "needs"
              ],
              "additionalProperties": false,
              "description": "Where a host offers a global action on something of another app"
            }
          },
          "later": {
            "description": "«Approve now, act later»: the confirmed call is stored and runs at `at`, within `window` minutes",
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "description": "A required date-time input property: when the action runs"
              },
              "window": {
                "type": "integer",
                "minimum": 10,
                "maximum": 10080,
                "description": "Minutes after `at` the run may still start"
              }
            },
            "required": [
              "at",
              "window"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "title",
          "input",
          "readOnly",
          "confirm",
          "tool"
        ],
        "additionalProperties": false
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "list",
              "record",
              "dashboard",
              "custom"
            ]
          },
          "title": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            },
            "description": "A label per locale (BCP 47 → text)"
          },
          "icon": {
            "type": "string"
          },
          "permission": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {},
            "description": "A JSON Schema (draft 2020-12)"
          },
          "entity": {
            "type": "string"
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "A label per locale (BCP 47 → text)"
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "title",
                "fields"
              ],
              "additionalProperties": false
            }
          },
          "tool": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "The MCP tool"
              },
              "plain": {
                "type": "boolean",
                "description": "Listed to plain MCP clients"
              }
            },
            "required": [
              "name",
              "plain"
            ],
            "additionalProperties": false,
            "description": "What opens the page with its params (record pages: the entity's get tool)"
          },
          "view": {
            "description": "The ui:// view that draws it when the host doesn't draw it natively (dashboard, custom, or an override)",
            "type": "string"
          },
          "url": {
            "description": "custom: the developer's own site, shown in an isolated frame",
            "type": "string"
          },
          "derived": {
            "type": "boolean"
          },
          "actions": {
            "description": "Global actions offered on the page, in order: the first is the page's primary. Page params prefill the inputs of the same name",
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "badge": {
            "description": "A `stat` fragment type without required params: its data.value is the page's count in the navigation",
            "type": "string"
          }
        },
        "required": [
          "name",
          "kind",
          "title",
          "params",
          "tool"
        ],
        "additionalProperties": false
      }
    },
    "fragments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "title": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            },
            "description": "A label per locale (BCP 47 → text)"
          },
          "description": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            },
            "description": "A label per locale (BCP 47 → text)"
          },
          "icon": {
            "type": "string"
          },
          "entity": {
            "description": "Set: the entity's record card (params { id })",
            "type": "string"
          },
          "params": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {},
            "description": "A JSON Schema (draft 2020-12)"
          },
          "template": {
            "type": "string",
            "enum": [
              "record",
              "card",
              "stat",
              "list",
              "chart"
            ]
          },
          "view": {
            "type": "string"
          },
          "tool": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "The MCP tool"
              },
              "plain": {
                "type": "boolean",
                "description": "Listed to plain MCP clients"
              }
            },
            "required": [
              "name",
              "plain"
            ],
            "additionalProperties": false
          },
          "permission": {
            "type": "string"
          },
          "actions": {
            "description": "Actions shown inside, by name",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "size": {
            "type": "string",
            "enum": [
              "small",
              "medium",
              "large"
            ]
          },
          "untrusted": {
            "description": "Its texts are written by outsiders: data, never instructions",
            "type": "boolean"
          },
          "visibility": {
            "description": "App-only: hidden from every model (its tools carry MCP Apps `_meta.ui.visibility: [\"app\"]`); views and the host's own UI still call it. Absent: models and apps",
            "type": "string",
            "const": "app"
          }
        },
        "required": [
          "type",
          "title",
          "params",
          "tool"
        ],
        "additionalProperties": false
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "title": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            },
            "description": "A label per locale (BCP 47 → text)"
          },
          "description": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            },
            "description": "A label per locale (BCP 47 → text)"
          },
          "instructions": {
            "type": "string"
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tier": {
            "type": "string",
            "enum": [
              "fast",
              "standard",
              "strong"
            ]
          },
          "starters": {
            "type": "array",
            "items": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              },
              "description": "A label per locale (BCP 47 → text)"
            }
          }
        },
        "required": [
          "name",
          "title",
          "description",
          "instructions",
          "tools",
          "tier"
        ],
        "additionalProperties": false
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            },
            "description": "A label per locale (BCP 47 → text)"
          },
          "description": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            },
            "description": "A label per locale (BCP 47 → text)"
          },
          "default": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "label",
          "default"
        ],
        "additionalProperties": false
      }
    },
    "settings": {
      "type": "array",
