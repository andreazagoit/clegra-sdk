# Copy to .env.local (`npm run setup` does it for you, with generated secrets). Never commit .env.local.

# The site's public origin: better-auth runs at <origin>/api/auth (the token issuer), MCP at <origin>/mcp (the
# token audience). Default locally http://localhost:3930; required in production (e.g. https://warehouse.example.com).
MODELAPP_PUBLIC_URL=

# Postgres (e.g. Neon: the pooled `-pooler` URL with ?sslmode=require). Unset: a local PGlite database in PGLITE_DIR
# (development only; production refuses to start without DATABASE_URL).
DATABASE_URL=
# Connections per server instance of the pg pool (default 5).
DATABASE_POOL_MAX=5
# Where the local PGlite database lives (default .data). `memory://` keeps it in memory (tests).
PGLITE_DIR=.data

# better-auth: a random secret of 32+ bytes (`openssl rand -base64 32`). Changing it signs everyone out.
BETTER_AUTH_SECRET=

# The password of the seeded demo users (12+ characters). Used by `npm run db:seed` and by the demo sign-in buttons.
DEMO_PASSWORD=
# 1: the sign-in page offers one-click «Enter as …» buttons for the demo users (the password stays on the server).
DEMO_SIGNIN=1

# Workspace hosts (e.g. a Clegra node) whose tokens the MCP server accepts: `issuer|jwksUri`, comma-separated. Each
# installation gets its own copy of the demo data on its first call.
# MODELAPP_ISSUERS=http://localhost:3003|http://localhost:3003/.well-known/jwks.json

# Who may frame /embed/* pages (Content-Security-Policy frame-ancestors): space-separated origins. Default 'self'.
EMBED_FRAME_ANCESTORS=

# For `npm run token` (an OAuth access token for `modelapp check`): a person's credentials, never on the command line.
MODELAPP_OAUTH_EMAIL=
MODELAPP_OAUTH_PASSWORD=
