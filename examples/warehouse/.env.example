# Copy to .env.local (`npm run setup` does it for you, with generated secrets). Never commit .env.local.

# The site's public origin: better-auth runs at <origin>/api/auth (the token issuer), MCP at <origin>/mcp (the
# token audience). Default locally http://localhost:3930; required in production (e.g. https://warehouse.example.com).
CLEGRA_PUBLIC_URL=

# Postgres (e.g. Neon: the pooled `-pooler` URL with ?sslmode=require). Unset: a local PGlite database in PGLITE_DIR
# (development only; production refuses to start without DATABASE_URL).
DATABASE_URL=
# Connections per server instance of the pg pool (default 5).
DATABASE_POOL_MAX=5
# Where the local PGlite database lives (default .data). `memory://` keeps it in memory (tests).
PGLITE_DIR=.data

# better-auth: a random secret of 32+ bytes (`openssl rand -base64 32`). Changing it signs everyone out. The site
# tickets and sessions of a Clegra client (the app's pages as its site) are signed with keys derived from it.
BETTER_AUTH_SECRET=

# The password of the seeded demo users (12+ characters). Used by `npm run db:seed` and by the demo sign-in buttons.
DEMO_PASSWORD=
# 1: the sign-in page offers one-click «Enter as …» buttons for the demo users (the password stays on the server).
DEMO_SIGNIN=1

# Clegra's core (spec §7, «Clegra tokens»): its issuer, the registration id and challenge it gave this app,
# the companies that may use it (`any` for a public app, else ids separated by commas) and the Clegra clients'
# origins (CORS, and who may frame the app's pages as its site). Production requires the registration id and the
# allowed companies.
# CLEGRA_ISSUER=http://localhost:3000
# CLEGRA_REGISTRATION_ID=
# CLEGRA_REGISTRATION_CHALLENGE=
# CLEGRA_ALLOWED_COMPANIES=any
# CLEGRA_CLIENT_ORIGINS=http://localhost:3111

# For `npm run token` (an OAuth access token for `clegra check`): a person's credentials, never on the command line.
CLEGRA_OAUTH_EMAIL=
CLEGRA_OAUTH_PASSWORD=
