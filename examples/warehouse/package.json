{
  "name": "clegra-example-warehouse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Reference app: a small warehouse (products, stock movements, orders) as a Next.js app with its own sign-in (better-auth) and plain SQL. Invented data.",
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "dev": "next dev -p 3930",
    "build": "next build",
    "start": "next start -p 3930",
    "typecheck": "tsc --noEmit -p .",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "token": "tsx --env-file-if-exists=.env.local scripts/oauth-token.ts"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.7",
    "@better-auth/core": "1.7.7",
    "@better-auth/mcp": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@better-auth/utils": "0.4.2",
    "@better-fetch/fetch": "1.3.2",
    "@electric-sql/pglite": "0.5.16",
    "better-auth": "1.7.7",
    "better-call": "1.4.0",
    "clegra": "file:../..",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.0.0",
    "jose": "^6.2.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "@types/pg": "^8"
  }
}
