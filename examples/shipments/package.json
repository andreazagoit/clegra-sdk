{
  "name": "clegra-example-shipments",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Example Clegra app: a courier's shipments and pickups on a Node server (@clegra/sdk/node), invented data in memory; also an in-process fixture for a workspace host's tests.",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./fixture": "./src/fixture.ts"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx src/main.ts --dev",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@clegra/sdk": "file:../..",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
