{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": { "@mcpw/server": ["../../../packages/mcp-workspaces/src/index.ts"], "@mcpw/server/testing": ["../../../packages/mcp-workspaces/src/testing.ts"] }
  },
  "include": ["src/**/*.ts"]
}
