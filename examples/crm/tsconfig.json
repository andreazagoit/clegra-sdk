{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": { "@modelapp/server": ["../../../packages/modelapp/src/index.ts"], "@modelapp/server/testing": ["../../../packages/modelapp/src/testing.ts"], "@modelapp/server/node": ["../../../packages/modelapp/src/node.ts"] }
  },
  "include": ["src/**/*.ts"]
}
