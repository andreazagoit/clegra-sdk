# Copy to .env.local (or run `npm run setup`, which writes one with generated values).

# The CRM's public origin: the one address everything derives from — better-auth at <origin>/api/auth (the OAuth
# issuer), the MCP server at <origin>/mcp. https, origin only. Local default http://localhost:3920; required in production.
CLEGRA_PUBLIC_URL=http://localhost:3920

# better-auth's secret: long and random (`openssl rand -base64 32`, 32 characters at least). It also encrypts the OAuth
# signing keys.
BETTER_AUTH_SECRET=

# Postgres. Unset locally: an embedded PGlite in .data/ (PGLITE_DATA_DIR to move it). Required in production.
# Neon: the pooled URL works (`-pooler` host: no prepared statements); keep `?sslmode=require`.
DATABASE_URL=
# DATABASE_POOL_MAX=5
# PGLITE_DATA_DIR=.data/pglite

# The demo accounts' password (used by `npm run db:seed`), and the one-click demo sign-in on /sign-in.
DEMO_PASSWORD=
DEMO_SIGNIN=1

# The workspace clients that show the CRM's pages as its site in their frame (spec §5.1), separated by commas: they
# alone may frame it. The person signs in there with the CRM's own sign-in. Unset: no site.
# CLEGRA_CLIENT_ORIGINS=http://localhost:3111
