# Copy to .env.local (or run `npm run setup`, which writes one with generated values).

# better-auth: a long random secret, and the CRM's public address.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3920

# Postgres. Unset locally: an embedded PGlite in .data/ (PGLITE_DATA_DIR to move it). Required in production.
DATABASE_URL=
# PGLITE_DATA_DIR=.data/pglite

# The demo accounts' password (used by `npm run db:seed`), and the one-click demo sign-in on /sign-in.
DEMO_PASSWORD=
DEMO_SIGNIN=1

# Workspace hosts (e.g. a Clegra node) whose tokens the MCP server accepts: `issuer|jwksUri`, comma-separated,
# with this server's public MCP address.
# MODELAPP_ISSUERS=http://localhost:3003|http://localhost:3003/.well-known/jwks.json
# MODELAPP_RESOURCE=http://localhost:3920/mcp
