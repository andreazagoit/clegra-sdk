{
  "name": "@modelapp/next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Model App Protocol (MAP) for Next.js: route handlers for a defineApp object, the rewrites for /mcp and /.well-known, the public address behind proxies, and bridges to the app's own sign-in (better-auth).",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./better-auth": "./src/better-auth.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:next": "tsx --test test/next.test.ts",
    "oauth-token": "tsx scripts/oauth-token.ts"
  },
  "dependencies": {
    "@modelapp/server": "*",
    "jose": "^6.2.13"
  },
  "peerDependencies": {
    "next": ">=15",
    "better-auth": "^1.7.7",
    "@better-auth/mcp": "^1.7.7"
  },
  "peerDependenciesMeta": {
    "better-auth": {
      "optional": true
    },
    "@better-auth/mcp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@better-auth/cimd": "1.7.7",
    "@better-auth/core": "1.7.7",
    "@better-auth/mcp": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@better-auth/utils": "0.4.2",
    "@better-fetch/fetch": "1.3.2",
    "@electric-sql/pglite": "0.5.16",
    "better-auth": "1.7.7",
    "better-call": "1.4.0",
    "next": "16.4.3",
    "zod": "^4.0.0"
  }
}
