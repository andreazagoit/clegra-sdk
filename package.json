{
  "name": "clegra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Clegra apps: one typed object — defineApp({ entities, actions, pages, fragments, agents, … }) — becomes a JSON manifest for workspace hosts and a plain, conformant MCP server (tools, annotations, MCP Apps views) for ChatGPT, Claude and any MCP client. Also: Next.js route handlers and rewrites (clegra/next), a Node server (clegra/node), a test client (clegra/testing), the conformance checks (clegra/spec) and the `clegra check` CLI. Spec: docs/developers/spec.md.",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "mcp-apps",
    "chatgpt-apps",
    "claude",
    "manifest",
    "nextjs",
    "oauth",
    "sdk"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "**/*.css"
  ],
