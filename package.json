{
  "name": "@clegra/sdk",
  "version": "0.1.0-next.7",
  "clegra": {
    "kind": "public",
    "owner": "sdk"
  },
  "type": "module",
  "description": "Clegra apps: one typed object — defineApp({ entities, actions, pages, artifacts, agents, … }) — becomes a JSON manifest for workspace hosts and a plain, conformant MCP server (tools, annotations, MCP Apps views, OAuth) for ChatGPT, Claude and any MCP client. Next.js and Node adapters, test client, conformance checks, CLI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreazagoit/clegra-sdk.git"
  },
  "homepage": "https://github.com/andreazagoit/clegra-sdk#readme",
  "bugs": {
    "url": "https://github.com/andreazagoit/clegra-sdk/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "mcp-apps",
    "chatgpt-apps",
    "claude",
    "manifest",
    "nextjs",
    "oauth",
    "sdk"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./next": "./src/next/index.ts",
    "./node": "./src/node.ts",
    "./testing": "./src/testing.ts",
    "./spec": "./spec/src/conformance.ts",
    "./spec/protocol": "./spec/src/protocol.ts",
    "./spec/kinds": "./spec/src/kinds.ts",
    "./clegra.schema.json": "./spec/schema/clegra.schema.json",
    "./kinds.json": "./spec/kinds.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "clegra": "spec/src/cli.ts"
  },
  "files": [
    "dist",
    "docs/spec.md",
    "docs/quickstart.md",
    "docs/accents.svg",
    "!docs/README.md",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md"
  ],
  "workspaces": [
    "examples/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:all": "npm run typecheck && npm run typecheck --workspaces --if-present",
    "test": "tsx --test \"{src,spec/src}/**/*.test.ts\"",
    "test:next": "tsx --test test/next.test.ts",
    "test:examples": "npm test --workspaces --if-present",
    "test:all": "npm test && npm run test:examples && npm run test:next",
    "pack:check": "tsx scripts/pack-check.mjs",
    "schema": "tsx scripts/schema.ts",
    "clegra:check": "tsx spec/src/cli.ts check",
    "prepack": "node scripts/prepack.mjs",
    "postpack": "node scripts/postpack.mjs",
    "postpublish": "node scripts/postpack.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "ajv": "^8.20.0",
    "jose": "^6.2.13"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=19",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "next": "16.4.6",
    "playwright": "1.64.1",
    "postcss": "8.5.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  },
  "overrides": {
    "@better-auth/core": "1.7.7",
    "better-call": "1.4.0",
    "@better-auth/utils": "0.4.2",
    "better-auth": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7"
  }
}
