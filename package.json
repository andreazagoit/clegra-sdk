{
  "name": "@clegra/sdk",
  "version": "0.4.0-next.3",
  "clegra": {
    "kind": "public",
    "owner": "sdk"
  },
  "type": "module",
  "description": "Clegra apps: a web app's MCP server (revision 2026-07-28) with the web-map and app-share extensions and the session-transfer, access and app-agents profiles: records at their own web URLs, pages for people, the app's own confirmation of irreversible calls, one sign-in for the MCP grant and the site. Definitions one per file (defineEntity, defineTool, definePage, …) assembled with defineApp and served on Web APIs with serve(app, …); the app's own OAuth 2.1 sign-in; Node, Express and Next.js adapters; a test client; the conformance check CLI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreazagoit/clegra-sdk.git"
  },
  "homepage": "https://github.com/andreazagoit/clegra-sdk#readme",
  "bugs": {
    "url": "https://github.com/andreazagoit/clegra-sdk/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "mcp-extensions",
    "web-map",
    "session-transfer",
    "claude",
    "chatgpt",
    "nextjs",
    "oauth",
    "sdk"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./next": "./src/next/index.ts",
    "./node": "./src/node.ts",
    "./express": "./src/express.ts",
    "./signin": "./src/signin/index.ts",
    "./testing": "./src/testing.ts",
    "./check": "./src/cli/check.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "clegra": "src/cli/index.ts"
  },
  "files": [
    "dist",
    "docs/spec.md",
    "docs/start-javascript.md",
    "docs/start-next.md",
    "docs/accents.svg",
    "docs/extensions",
    "!docs/README.md",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:next": "tsx --test test/next.test.ts",
    "test:postgres": "node scripts/test-postgres.mjs",
    "test:all": "npm test && npm run test:next && npm run test:postgres",
    "pack:check": "tsx scripts/pack-check.mjs",
    "clegra:check": "tsx src/cli/index.ts check",
    "prepack": "node scripts/prepack.mjs",
    "postpack": "node scripts/postpack.mjs",
    "postpublish": "node scripts/postpack.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "jose": "^6.2.13"
  },
  "peerDependencies": {
    "next": ">=15",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "next": "16.4.6",
    "playwright": "1.64.1",
    "postcss": "8.5.32",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  },
  "overrides": {
    "@better-auth/core": "1.7.7",
    "better-call": "1.4.0",
    "@better-auth/utils": "0.4.2",
    "better-auth": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7"
  }
}
